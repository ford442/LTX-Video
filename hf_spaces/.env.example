# Remote Text Encoder Configuration Example
# Copy this file to .env and update with your values

# =============================================================================
# LTX-2 Text Encoder Space Configuration
# =============================================================================

# This is the main encoder space that hosts the Gemma-3 12B text encoder
# Deploy this space first and note its URL
# Example: https://huggingface.co/spaces/YOUR_USERNAME/ltx-2-text-encoder

# No special environment variables needed for the encoder space itself
# It will load the model and provide API endpoints automatically


# =============================================================================
# LTX Video Distilled Tester Space Configuration
# =============================================================================

# Enable remote text encoding (default: false)
# When true, the space will not load its local T5 text encoder
# and will instead call the remote encoder space via API
USE_REMOTE_TEXT_ENCODER=true

# URL of the remote encoder space
# Format: username/space-name (e.g., "ford442/ltx-2-text-encoder")
# Or full URL (e.g., "https://huggingface.co/spaces/ford442/ltx-2-text-encoder")
REMOTE_ENCODER_SPACE_URL=YOUR_USERNAME/ltx-2-text-encoder

# Example with full setup:
# USE_REMOTE_TEXT_ENCODER=true
# REMOTE_ENCODER_SPACE_URL=ford442/ltx-2-text-encoder


# =============================================================================
# SD3.5 Large LoRA Space Configuration
# =============================================================================

# Note: SD3.5 has limited support for remote encoding due to integrated
# text encoders in the diffusers pipeline. For better memory optimization,
# use the LTX Video Distilled Tester space instead.

# Enable experimental remote text encoding support
USE_REMOTE_TEXT_ENCODER=false


# =============================================================================
# Testing Configuration
# =============================================================================

# For local testing, you can run the encoder space locally and point to it:
# REMOTE_ENCODER_SPACE_URL=http://localhost:7860


# =============================================================================
# Memory Usage Expectations
# =============================================================================

# Without remote encoding (LTX Video Distilled Tester):
#   - Total VRAM: ~24GB
#   - T5 Text Encoder: ~8GB
#   - Transformer + VAE: ~16GB

# With remote encoding (LTX Video Distilled Tester):
#   - Total VRAM: ~16GB
#   - T5 Text Encoder: 0GB (offloaded)
#   - Transformer + VAE: ~16GB
#   - Savings: ~8GB VRAM

# Remote Encoder Space:
#   - VRAM: ~13-15GB (Gemma-3 12B in bfloat16)


# =============================================================================
# Performance Considerations
# =============================================================================

# Remote encoding adds network latency:
#   - Local encoding: ~0.5-2s
#   - Remote encoding: ~1-3s (includes network overhead)

# Best for:
#   - Interactive applications where memory is limited
#   - Multiple consumer spaces sharing one encoder
#   - Development/testing with smaller GPU instances

# Not recommended for:
#   - High-throughput batch processing
#   - Scenarios where sub-second latency is critical
#   - Offline workflows without network access


# =============================================================================
# Troubleshooting
# =============================================================================

# If you see "Failed to connect to remote encoder":
#   1. Check that REMOTE_ENCODER_SPACE_URL is correct
#   2. Verify the encoder space is running and accessible
#   3. Check that both spaces are public or have proper access
#   4. Look for firewall or network issues

# If you see "Failed to deserialize tensor":
#   1. Ensure both spaces are using compatible versions
#   2. Check that gradio_client is installed
#   3. Verify the tensor serialization format matches

# If embeddings don't work correctly:
#   1. Check the shapes match expected dimensions
#   2. Verify device placement (CPU vs GPU)
#   3. Look for dtype mismatches (bfloat16 vs float32)
